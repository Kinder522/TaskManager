FROM node:20-alpine

WORKDIR /app

# Копируем файлы манифеста зависимостей
COPY package*.json ./

# Устанавливаем библиотеки прямо внутри контейнера
RUN npm install

# Копируем весь остальной код фронтенда
COPY . .

# Открываем дефолтный порт Vite
EXPOSE 5173

# Запускаем сервер разработки Vite с флагом --host,
# чтобы он отдавал наружу страницы из контейнера в Windows
CMD ["npm", "run", "dev", "--", "--host"]